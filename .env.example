# Server & Environment
NODE_ENV=development
PORT=3000

# Base de datos (SQLite en local / PostgreSQL en producción)
DATABASE_URL="file:./dev.db"
# En producción (PostgreSQL):
# DATABASE_URL="postgresql://user:password@localhost:5432/steamstats?schema=public"

# Steam Web API (Obtener gratuitamente en https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=""

# IsThereAnyDeal API (Opcional, para mínimos históricos de precios)
ITAD_API_KEY=""

# IGDB API (Opcional, requiere Twitch Developer Client ID y Secret)
# https://api-docs.igdb.com/#about
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""

# Dominios y enlaces del ecosistema GuacamoleGH
NEXT_PUBLIC_HUB_URL="https://hub.guacamolegh.es"
NEXT_PUBLIC_SITE_URL="https://steamstats.guacamolegh.es"
