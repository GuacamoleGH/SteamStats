{
  "name": "steamstats",
  "version": "0.1.0",
  "private": true,
  "description": "Estadísticas avanzadas de perfiles de Steam para el homelab GuacamoleGH",
  "author": "GuacamoleGH",
  "license": "MIT",
  "scripts": {
    "dev": "node --require ./scripts/patch-exfat.js node_modules/next/dist/bin/next dev",
    "build": "prisma generate && node --require ./scripts/patch-exfat.js node_modules/next/dist/bin/next build",
    "start": "node --require ./scripts/patch-exfat.js node_modules/next/dist/bin/next start",
    "lint": "node --require ./scripts/patch-exfat.js node_modules/next/dist/bin/next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "worker": "tsx worker/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "node-cron": "^3.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.0.1",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
